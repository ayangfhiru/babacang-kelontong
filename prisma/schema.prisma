// Prisma schema — Babacang Kelontong store management
// https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  // `join` load strategy: relasi dimuat lewat LATERAL JOIN tunggal alih-alih
  // query per tabel yang dijalankan paralel pada satu koneksi transaksi
  // (pemicu DeprecationWarning pg@8 "client.query() when already executing").
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Master Data
// ============================================================================

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("categories")
}

model Brand {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  logo        String?
  isActive    Boolean @default(true) @map("is_active")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("brands")
}

model Unit {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  symbol      String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("units")
}

model Product {
  id      String  @id @default(uuid()) @db.Uuid
  sku     String  @unique
  barcode String? @unique
  name    String

  description String?

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brandId String? @map("brand_id") @db.Uuid
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  unitId String @map("unit_id") @db.Uuid
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // Money is stored as Decimal(14, 2) — never as floating point.
  purchasePrice Decimal @default(0) @map("purchase_price") @db.Decimal(14, 2)
  sellingPrice  Decimal @default(0) @map("selling_price") @db.Decimal(14, 2)

  image    String?
  isActive Boolean @default(true) @map("is_active")

  batches         StockBatch[]
  movements       StockMovement[]
  purchaseItems   PurchaseItem[]
  salesItems      SalesItem[]
  returnItems     ReturnItem[]
  adjustmentItems StockAdjustmentItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([isActive])
  @@index([name])
  @@map("products")
}

model Supplier {
  id            String  @id @default(uuid()) @db.Uuid
  code          String? @unique
  name          String
  contactPerson String? @map("contact_person")
  email         String?
  // Phone numbers are stored as strings to preserve leading zeros and separators.
  phone         String?
  address       String?
  notes         String?
  isActive      Boolean @default(true) @map("is_active")

  purchases Purchase[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("suppliers")
}

// ============================================================================
// Authentication
// ============================================================================

enum UserRole {
  ADMIN
  STAFF

  @@map("user_role")
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  name             String
  // Legacy credential column from the pre-Better-Auth era. Nullable so the
  // Better Auth adapter (which stores passwords in `accounts`) can create
  // users. Existing rows keep their value for reference; authentication must
  // only read `accounts.password` (providerId "credential").
  passwordHash     String?  @map("password_hash")
  role             UserRole @default(STAFF)
  isActive         Boolean  @default(true) @map("is_active")

  // Better Auth core fields.
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  username         String?  @unique
  displayUsername  String?  @map("display_username")

  purchases        Purchase[]
  sales            Sales[]
  returns          Return[]
  stockAdjustments StockAdjustment[]
  stockMovements   StockMovement[]
  sessions         Session[]
  accounts         Account[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

/// Better Auth session (sliding expiry, refreshed on use).
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

/// Better Auth credential/OAuth account. Credential passwords live here
/// (`providerId = "credential"`, hash in `password`).
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

/// Better Auth one-time tokens (email verification, password reset, ...).
model Verification {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
}

// ============================================================================
// Transactions & Stock (FIFO)
// ============================================================================

enum TransactionStatus {
  DRAFT
  POSTED
  CANCELLED

  @@map("transaction_status")
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT
  PURCHASE_CANCEL
  SALE_CANCEL
  RETURN_CANCEL
  ADJUSTMENT_CANCEL

  @@map("stock_movement_type")
}

/// A receive-batch of stock for one product, carrying the acquisition cost and
/// optional expiry date that FIFO/COGS calculations depend on.
model StockBatch {
  id              String        @id @default(uuid()) @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  // `@db.Uuid` wajib: PK yang dirujuk bertipe uuid — tanpa ini, strategi load
  // `join` menghasilkan SQL `text = uuid` yang ditolak PostgreSQL (42883).
  purchaseItemId  String?       @unique @map("purchase_item_id") @db.Uuid
  purchaseItem    PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  batchNumber     String?       @map("batch_number")
  receivedAt      DateTime      @map("received_at")
  expiredAt       DateTime?     @map("expired_at")
  quantityInitial Int           @map("quantity_initial")
  quantityRemain  Int           @map("quantity_remain")
  unitCost        Decimal       @map("unit_cost") @db.Decimal(14, 2)

  allocations     StockAllocation[]
  movements       StockMovement[]
  returnItems     ReturnItem[]          @relation("ReturnInBatch")
  adjustmentItems StockAdjustmentItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId, receivedAt])
  @@index([expiredAt])
  @@map("stock_batches")
}

/// Auditable record of every stock change (in or out) for a product/batch.
model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId       String?           @map("batch_id") @db.Uuid
  batch         StockBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type          StockMovementType
  quantity      Int
  userId        String?           @map("user_id") @db.Uuid
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  note          String?
  occurredAt    DateTime          @default(now()) @map("occurred_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId, occurredAt])
  @@index([batchId])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Purchase {
  id         String            @id @default(uuid()) @db.Uuid
  number     String            @unique
  supplierId String            @map("supplier_id") @db.Uuid
  supplier   Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status     TransactionStatus @default(DRAFT)
  date       DateTime
  notes      String?
  subtotal   Decimal           @default(0) @db.Decimal(14, 2)
  discount   Decimal           @default(0) @db.Decimal(14, 2)
  total      Decimal           @default(0) @db.Decimal(14, 2)
  userId     String            @map("user_id") @db.Uuid
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  items       PurchaseItem[]
  returnItems ReturnItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([supplierId])
  @@index([status])
  @@index([date])
  @@map("purchases")
}

model PurchaseItem {
  id          String    @id @default(uuid()) @db.Uuid
  purchaseId  String    @map("purchase_id") @db.Uuid
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String    @map("product_id") @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitCost    Decimal   @map("unit_cost") @db.Decimal(14, 2)
  discount    Decimal   @default(0) @db.Decimal(14, 2)
  subtotal    Decimal   @default(0) @db.Decimal(14, 2)
  batchNumber String?   @map("batch_number")
  expiredAt   DateTime? @map("expired_at")

  batch       StockBatch?
  returnItems ReturnItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sales {
  id       String            @id @default(uuid()) @db.Uuid
  number   String            @unique
  status   TransactionStatus @default(DRAFT)
  date     DateTime
  notes    String?
  subtotal Decimal           @default(0) @db.Decimal(14, 2)
  discount Decimal           @default(0) @db.Decimal(14, 2)
  tax      Decimal           @default(0) @db.Decimal(14, 2)
  total    Decimal           @default(0) @db.Decimal(14, 2)
  cogs     Decimal           @default(0) @map("cogs") @db.Decimal(14, 2)
  userId   String            @map("user_id") @db.Uuid
  user     User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  items SalesItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([date])
  @@map("sales")
}

model SalesItem {
  id        String  @id @default(uuid()) @db.Uuid
  salesId   String  @map("sales_id") @db.Uuid
  sales     Sales   @relation(fields: [salesId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(14, 2)
  subtotal  Decimal @default(0) @db.Decimal(14, 2)
  cogs      Decimal @default(0) @db.Decimal(14, 2)

  allocations StockAllocation[]
  returnItems ReturnItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([salesId])
  @@index([productId])
  @@map("sales_items")
}

/// FIFO allocation of a sales line against one or more stock batches.
model StockAllocation {
  id          String     @id @default(uuid()) @db.Uuid
  salesItemId String     @map("sales_item_id") @db.Uuid
  salesItem   SalesItem  @relation(fields: [salesItemId], references: [id], onDelete: Cascade)
  batchId     String     @map("batch_id") @db.Uuid
  batch       StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity    Int
  unitCost    Decimal    @map("unit_cost") @db.Decimal(14, 2)
  totalCost   Decimal    @map("total_cost") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([salesItemId])
  @@index([batchId])
  @@map("stock_allocations")
}

enum ReturnKind {
  SALE
  PURCHASE

  @@map("return_kind")
}

model Return {
  id        String            @id @default(uuid()) @db.Uuid
  number    String            @unique
  kind      ReturnKind
  status    TransactionStatus @default(DRAFT)
  date      DateTime
  reason    String?
  condition String?
  notes     String?
  userId    String            @map("user_id") @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  items ReturnItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kind])
  @@index([status])
  @@index([date])
  @@map("returns")
}

model ReturnItem {
  id       String @id @default(uuid()) @db.Uuid
  returnId String @map("return_id") @db.Uuid
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  salesItemId    String?       @map("sales_item_id") @db.Uuid
  salesItem      SalesItem?    @relation(fields: [salesItemId], references: [id], onDelete: Restrict)
  purchaseItemId String?       @map("purchase_item_id") @db.Uuid
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitCost  Decimal @default(0) @map("unit_cost") @db.Decimal(14, 2)
  subtotal  Decimal @default(0) @db.Decimal(14, 2)

  /// For sale returns: whether the goods go back into a sellable batch.
  restock Boolean     @default(false)
  /// Batch the returned goods re-enter (sale return restock) or are taken from (purchase return).
  batchId String?     @map("batch_id") @db.Uuid
  batch   StockBatch? @relation("ReturnInBatch", fields: [batchId], references: [id], onDelete: Restrict)

  createdAt  DateTime  @default(now()) @map("created_at")
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  purchaseId String?   @map("purchase_id") @db.Uuid

  @@index([returnId])
  @@map("return_items")
}

model StockAdjustment {
  id     String            @id @default(uuid()) @db.Uuid
  number String            @unique
  status TransactionStatus @default(DRAFT)
  date   DateTime
  reason String?
  notes  String?
  userId String            @map("user_id") @db.Uuid
  user   User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  items StockAdjustmentItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([date])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String          @id @default(uuid()) @db.Uuid
  adjustmentId String          @map("adjustment_id") @db.Uuid
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String          @map("product_id") @db.Uuid
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId      String?         @map("batch_id") @db.Uuid
  batch        StockBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  systemQty    Int             @map("system_qty")
  physicalQty  Int             @map("physical_qty")
  difference   Int
  unitCost     Decimal         @default(0) @map("unit_cost") @db.Decimal(14, 2)
  reason       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adjustmentId])
  @@map("stock_adjustment_items")
}
