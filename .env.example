# PostgreSQL connection string used by the application (Prisma driver adapter @prisma/adapter-pg)
# and by the Prisma CLI (migrations).
#
# Local development with `prisma dev` (Prisma Postgres, default ports): use the TCP URL printed by
# `prisma dev` with your application database name. `@prisma/adapter-pg` requires a plain
# `postgres://` URL — the `prisma+postgres://` URL is only understood by the Prisma CLI/Studio.
# Production: use your managed PostgreSQL connection string.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable"
