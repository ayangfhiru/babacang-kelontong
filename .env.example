# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
# sslmode=verify-full (Alternatif 1): selalu verifikasi sertifikat & hostname
# server. Jangan diturunkan ke require/prefer — pg-connection-string memberi
# warning keamanan karena mode tersebut akan berubah makna di pg v9.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true&sslmode=verify-full"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=